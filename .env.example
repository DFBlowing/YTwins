# YTwins 的本机配置模板。
#
# 用法：把它复制成同目录下的 `.env`（`copy .env.example .env`），填好里面的东西。
# `.env` 被 .gitignore 忽略，永远不会进 git；只有本机服务端会读它，浏览器拿不到。
# 改完重启服务：npm run server
#
# ── 只填两行：选一家，填一个 key ──────────────────────────────────
#
# 换后端模型 = 改第一行的值 + 填 key。三家（DeepSeek / Gemini / opencode）各有一行预设，
# 每行自带端点、默认模型和 key 放在哪个头里 —— 所以换家不用改调用路径，只换值。
YTwins_LLM_PRESET=deepseek
YTwins_LLM_API_KEY=

# 预设表（2026-09-18 逐条核过；出处见 src/ai/config.ts 的注释）：
#
#   deepseek   https://api.deepseek.com                              deepseek-flash
#   gemini     https://generativelanguage.googleapis.com/v1beta/openai   gemini-3.8-flash
#   opencode   https://opencode.ai/zen/v1                            deepseek-v4-flash
#   ollama     http://127.0.0.1:11434/v1                             qwen2.5:7b（本地，不要 key）
#   custom     端点与模型都必须在下面显式给出来
#
# key 怎么送：deepseek / gemini / opencode / custom 都是 `Authorization: Bearer <key>`；
# ollama 跑在本机、不需要 key（真要给一个，也照 Bearer 送）。
# opencode 的 free/Go 档还要一个会话头，那种头用下面的 YTwins_LLM_HEADERS 配
# —— 它是凭证，别写进这个会进 git 的文件。
#
# 预设名不存在、或 YTwins_LLM 与预设的「云端／本机」相互矛盾，都会在启动时响亮拒绝
# （把云端端点说成本机，等于告诉用户「你的话没离开这台机器」，这是唯一不许出的错）。
#
# ── 下面全都有默认值，只有要改的时候才取消注释 ────────────────────
#
# 不选预设时，行为与从前一字不差：云端 LLM 默认 DeepSeek `deepseek-flash` + 本机 embedding。
# 显式变量**优先于预设**，是逃生口 —— 覆盖了哪个，启动日志会点名说出来。
#
# YTwins_LLM_BASE_URL=https://api.example.com/v1   # 覆盖预设的端点
# YTwins_LLM_MODEL=some-model                     # 覆盖预设的模型
# YTwins_LLM=cloud                                # 不选预设时：cloud（默认）| local
#                                                 # 选了预设：只能与预设一致（custom 除外，它靠这一行说明是不是本机）
# YTwins_LLM_HEADERS=x-opencode-session=abc;x-foo=bar   # 额外请求头，多段用 ; 隔开
#                                                 # 值绝不进日志；头名不许是 content-type / accept，
#                                                 # 也不许是 key 的那个头（已经配了 key 时）
# YTwins_LLM_TIMEOUT_MS=120000
#
# YTwins_PROVIDER=demo              # 用 01–11 的预置假 provider（不联网、不花 key，只用于演示）
#
# ── embedding 不在「只填一个 key」的承诺里 ───────────────────────
#
# 链接阈值是对着具体 embedding 标定过的（换一家会让真相关对从 0.875 掉到 0.456），
# 所以本地模型仍是默认；真要换云端 embedding，端点与 key 都得显式给，并且要重跑标定：
#
# YTwins_EMBEDDING=cloud            # 云端 embedding：必须是 OpenAI 兼容的 /embeddings 端点
# YTwins_EMBEDDING_BASE_URL=https://api.example.com/v1
# YTwins_EMBEDDING_MODEL=text-embedding-3-small
# YTwins_EMBEDDING_API_KEY=sk-…     # 不复用上面那把 LLM 的 key，两者是不同的服务
#
# YTwins_EMBEDDING=local            # 本机 transformers.js，第一次使用会联网下载模型（默认）
# YTwins_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# YTwins_EMBEDDING_HOST=https://huggingface.co   # 下载慢时可换镜像，例如 https://hf-mirror.com
